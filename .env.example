# Copy the values from Firebase Console > Project settings > Your apps > Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=somedaysinmay
VITE_FIREBASE_APP_ID=

# Server-only email settings. Set as Cloudflare Pages environment variables/secrets.
# For local development, put real values in ignored .env.local. Never prefix with VITE_.
CLOUDFLARE_EMAIL_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
INQUIRY_FROM_EMAIL=
INQUIRY_NOTIFICATION_EMAIL=

