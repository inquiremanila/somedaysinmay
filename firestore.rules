rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validAuctionBid(auctionId) {
      let before = resource.data;
      let after = request.resource.data;
      let bidAfter = getAfter(
        /databases/$(database)/documents/auctions/$(auctionId)/bids/$(after.latestBidId)
      );

      return signedIn()
        && before.status == 'open'
        && before.startsAt <= request.time
        && request.time < before.endsAt
        && before.currentBid is int
        && before.minimumIncrement is int
        && before.minimumIncrement > 0
        && before.bidCount is int
        && after.diff(before).affectedKeys().hasOnly([
          'currentBid',
          'bidCount',
          'latestBidId',
          'updatedAt'
        ])
        && after.currentBid is int
        && after.currentBid >= before.currentBid + before.minimumIncrement
        && after.bidCount == before.bidCount + 1
        && after.latestBidId is string
        && after.updatedAt == request.time
        && bidAfter.data.auctionId == auctionId
        && bidAfter.data.bidderUid == request.auth.uid
        && bidAfter.data.amount == after.currentBid
        && bidAfter.data.createdAt == request.time;
    }

    function validBidRecord(auctionId, bidId) {
      let auctionBefore = get(
        /databases/$(database)/documents/auctions/$(auctionId)
      );
      let auctionAfter = getAfter(
        /databases/$(database)/documents/auctions/$(auctionId)
      );

      return signedIn()
        && request.resource.data.keys().hasOnly([
          'auctionId',
          'bidderUid',
          'amount',
          'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'auctionId',
          'bidderUid',
          'amount',
          'createdAt'
        ])
        && request.resource.data.auctionId == auctionId
        && request.resource.data.bidderUid == request.auth.uid
        && request.resource.data.amount is int
        && request.resource.data.createdAt == request.time
        && auctionBefore.data.status == 'open'
        && auctionBefore.data.startsAt <= request.time
        && request.time < auctionBefore.data.endsAt
        && auctionAfter.data.latestBidId == bidId
        && auctionAfter.data.currentBid == request.resource.data.amount
        && auctionAfter.data.bidCount == auctionBefore.data.bidCount + 1
        && auctionAfter.data.updatedAt == request.time;
    }

    function ownsUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validShippingDetails(shipping) {
      return shipping is map
        && shipping.keys().hasOnly(['name', 'address', 'city', 'postcode', 'phone'])
        && shipping.keys().hasAll(['name', 'address', 'city', 'postcode', 'phone'])
        && shipping.name is string
        && shipping.name.size() > 0
        && shipping.name.size() <= 120
        && shipping.address is string
        && shipping.address.size() > 0
        && shipping.address.size() <= 300
        && shipping.city is string
        && shipping.city.size() > 0
        && shipping.city.size() <= 120
        && shipping.postcode is string
        && shipping.postcode.size() > 0
        && shipping.postcode.size() <= 32
        && shipping.phone is string
        && shipping.phone.size() <= 40;
    }

    function validOrderInquiry() {
      return request.resource.data.keys().hasOnly([
          'intent',
          'message',
          'contactEmail',
          'shipping',
          'items',
          'status',
          'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'contactEmail',
          'shipping',
          'items',
          'status',
          'createdAt'
        ])
        && (!('intent' in request.resource.data) || request.resource.data.intent in ['inquiry', 'purchase'])
        && (!('message' in request.resource.data) || (request.resource.data.message is string && request.resource.data.message.size() <= 4000))
        && request.resource.data.contactEmail is string
        && request.resource.data.contactEmail.size() > 3
        && request.resource.data.contactEmail.size() <= 254
        && validShippingDetails(request.resource.data.shipping)
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.status == 'inquiry'
        && request.resource.data.createdAt == request.time;
    }

    match /users/{userId} {
      allow get: if ownsUser(userId);
      allow list: if false;
      allow create: if ownsUser(userId)
        && request.resource.data.keys().hasOnly(['email', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['email', 'createdAt', 'updatedAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if ownsUser(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'updatedAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;

      match /cart/{productId} {
        allow get, list: if ownsUser(userId);
        allow create, update: if ownsUser(userId)
          && request.resource.data.keys().hasOnly(['quantity', 'updatedAt'])
          && request.resource.data.keys().hasAll(['quantity', 'updatedAt'])
          && request.resource.data.quantity is int
          && request.resource.data.quantity >= 1
          && request.resource.data.quantity <= 99
          && request.resource.data.updatedAt == request.time;
        allow delete: if ownsUser(userId);
      }

      match /contactInquiries/{inquiryId} {
        allow get, list: if ownsUser(userId);
        allow create: if ownsUser(userId)
          && request.resource.data.keys().hasOnly(['name', 'contactEmail', 'location', 'size', 'budget', 'message', 'status', 'createdAt'])
          && request.resource.data.keys().hasAll(['name', 'contactEmail', 'location', 'size', 'budget', 'message', 'status', 'createdAt'])
          && request.resource.data.contactEmail == request.auth.token.email
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 120
          && request.resource.data.location is string
          && request.resource.data.location.size() <= 150
          && request.resource.data.size is string
          && request.resource.data.size.size() <= 150
          && request.resource.data.budget is string
          && request.resource.data.budget.size() <= 150
          && request.resource.data.message is string
          && request.resource.data.message.size() > 0
          && request.resource.data.message.size() <= 4000
          && request.resource.data.status == 'inquiry'
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      match /inquiries/{inquiryId} {
        allow get, list: if ownsUser(userId);
        allow create: if ownsUser(userId)
          && request.resource.data.keys().hasOnly(['productId', 'contactEmail', 'message', 'status', 'createdAt'])
          && request.resource.data.keys().hasAll(['productId', 'contactEmail', 'message', 'status', 'createdAt'])
          && request.resource.data.productId is string
          && request.resource.data.productId.size() > 0
          && request.resource.data.productId.size() <= 120
          && request.resource.data.contactEmail == request.auth.token.email
          && request.resource.data.message is string
          && request.resource.data.message.size() > 0
          && request.resource.data.message.size() <= 4000
          && request.resource.data.status == 'inquiry'
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      match /orders/{orderId} {
        allow get, list: if ownsUser(userId);
        allow create: if ownsUser(userId) && validOrderInquiry();
        allow update, delete: if false;
      }
    }

    match /auctions/{auctionId} {
      allow get, list: if true;
      allow create, delete: if false;
      allow update: if validAuctionBid(auctionId);

      match /bids/{bidId} {
        allow get, list: if signedIn() && resource.data.bidderUid == request.auth.uid;
        allow create: if validBidRecord(auctionId, bidId);
        allow update, delete: if false;
      }
    }
  }
}
